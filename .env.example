# Read by catalog:sync and tag:jev. Never place these in public/ or browser config.
HF_TOKEN=
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Shell-only, not read from .env:
# PORT=4173                       dev server port
# CHROMIUM_EXECUTABLE=            browser suite Chromium override
# R2_ENV=./r2.env                 box-run.sh credentials file with
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET
# PAUSE_PATTERN=                  box-run.sh pauses matching processes
